{
  "name": "marrow",
  "version": "1.0.0",
  "private": true,
  "description": "Turn AI coding-session transcripts into durable, searchable lessons.",
  "license": "MIT",
  "author": "Dallas Crilley",
  "homepage": "https://github.com/dallascrilley/marrow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dallascrilley/marrow.git"
  },
  "bugs": {
    "url": "https://github.com/dallascrilley/marrow/issues"
  },
  "keywords": [
    "cli",
    "ai-agents",
    "claude-code",
    "cursor",
    "codex",
    "transcripts",
    "knowledge-base",
    "mcp",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "marrow": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "marrow": "npm run build --silent && node dist/cli.js",
    "memory:pipeline:dry-run": "node scripts/memory-pipeline-dry-run.mjs",
    "corpus:resummarize": "npm run build && node scripts/resummarize-corpus.mjs",
    "corpus:resummarize:dry-run": "npm run build && node scripts/resummarize-corpus.mjs --dry-run",
    "proof:smoke": "npm run build && node scripts/proof-smoke.mjs",
    "test": "npm run build && node --test --test-concurrency=1 $(find test -name '*.test.mjs' -print)",
    "test:smoke": "npm run build && node --test test/cli.test.mjs",
    "lint": "biome check src test scripts",
    "format": "biome format --write src test scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^22.15.31",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
