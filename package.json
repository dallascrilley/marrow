{
  "name": "agent-session-distillery",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone CLI for agent session distillery workflows.",
  "type": "module",
  "bin": {
    "asd": "./dist/cli.js"
  },
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "memory:pipeline:dry-run": "node scripts/memory-pipeline-dry-run.mjs",
    "corpus:resummarize": "npm run build && node scripts/resummarize-corpus.mjs",
    "corpus:resummarize:dry-run": "npm run build && node scripts/resummarize-corpus.mjs --dry-run",
    "proof:smoke": "npm run build && node scripts/proof-smoke.mjs",
    "test": "npm run build && node --test $(find test -name '*.test.mjs' -print)",
    "test:smoke": "npm run build && node --test test/cli.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.31",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "zod": "^4.4.3"
  }
}
