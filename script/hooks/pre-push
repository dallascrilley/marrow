#!/usr/bin/env bash
#
# pre-push — arm the CI safety net locally so broken work cannot reach origin.
#
# The CI workflow (.github/workflows/ci.yml) only runs on pull_request and
# push to main, so feature-branch pushes get NO CI until a PR exists. That
# gap let unpushed commits accumulate a red test suite and lint debt that
# `npm test` alone never caught (it builds + tests but does NOT lint; only
# CI's cibuild lints). This hook runs lint + test (npm test also builds),
# mirroring everything CI validates except the clean `npm ci` install.
#
# Escape hatch: `git push --no-verify` or `ASD_SKIP_PREPUSH=1 git push`
set -euo pipefail

if [[ "${ASD_SKIP_PREPUSH:-}" == "1" ]]; then
  printf '\033[1;33mwarn:\033[0m ASD_SKIP_PREPUSH=1 — skipping pre-push checks\n' >&2
  exit 0
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." >/dev/null && pwd)"
cd "$ROOT"

printf '\033[1;34m==>\033[0m pre-push: lint\n'
npm run lint
printf '\033[1;34m==>\033[0m pre-push: test (build + full suite)\n'
npm test
