{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": { "recommended": true }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "files": {
    "includes": [
      "src/**",
      "test/**",
      "scripts/**",
      "biome.json",
      "package.json",
      "tsconfig.json",
      "!**/dist",
      "!**/build",
      "!**/coverage",
      "!**/node_modules",
      "!**/*.min.*",
      "!**/.omc",
      "!**/.omx",
      "!**/.pi",
      "!**/.pi-lens",
      "!**/.ijfw",
      "!**/.todos"
    ]
  }
}
